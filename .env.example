# Neon: Connection string (pooled) dari dashboard Neon
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# String acak panjang: openssl rand -base64 32
AUTH_SECRET=
# URL situs (lokal: http://localhost:3000, Vercel: https://domainmu.vercel.app)
APP_URL=http://localhost:3000
# Nomor WA admin untuk pengajuan, format 628xxxx
ADMIN_WA=
# Token untuk API admin (ubah status pesanan)
ADMIN_TOKEN=
# Google OAuth (opsional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
